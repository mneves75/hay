{
  "name": "hay-video",
  "version": "1.1.0",
  "description": "Remotion source for the hay editorial overview film",
  "repository": "https://github.com/mneves75/hay",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "@remotion/cli": "4.0.515",
    "@remotion/fonts": "4.0.515",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.515"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.521",
    "@types/react": "19.2.18",
    "@types/web": "0.0.354",
    "eslint": "10.9.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  },
  "scripts": {
    "prepare:film": "node scripts/prepare.mjs",
    "test": "node --test scripts/prepare.test.mjs",
    "dev": "node scripts/prepare.mjs && remotion studio",
    "build": "node scripts/prepare.mjs && remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "node scripts/prepare.mjs && eslint src && tsc",
    "render": "node scripts/prepare.mjs && remotion render HayBenchmark out/hay-benchmark.mp4 --muted"
  },
  "engines": {
    "node": ">=24.19.0"
  }
}
