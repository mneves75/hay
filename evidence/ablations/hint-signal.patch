+#[test]
 fn a_non_ascii_query_does_not_crash_the_ranker() {
     // Found in review and reproduced here first: scanning a line for a multibyte query advanced
     // one BYTE past a rejected occurrence, so `hay -F -e 'éé'` over `let x = aéé` sliced inside a
--- a/hay/differential-test.sh
+++ b/hay/differential-test.sh
@@ -103,6 +103,34 @@
   compare_stream "$repo" stream-broad -i -F -e e
 done
 
+# `--hint` is ranking-only, so only hay receives it. The primary matcher and walker stay
+# byte-for-byte identical; sorting both outputs proves the optional signal changed no match.
+compare_hint() {
+  local repo=$1 label=$2 hint=$3
+  shift 3
+  local a b
+  a=$(cd "$repo" && rg "${RG_BASE[@]}" -n "$@" . 2>/dev/null | sed 's|^\./||' | sort)
+  b=$(cd "$repo" && "$HAY" "${HAY_BASE[@]}" --hint "$hint" -n "$@" . 2>/dev/null | sed 's|^\./||' | sort)
+  if [ "$a" = "$b" ]; then
+    pass=$((pass+1))
+  else
+    fail=$((fail+1))
+    echo "DIFFERS  $(basename "$repo")  $label  rg=$(printf '%s' "$a" | grep -c .) hay=$(printf '%s' "$b" | grep -c .)"
+    diff <(printf '%s\n' "$a") <(printf '%s\n' "$b") | head -5
+  fi
+}
+
+for repo in "${REPOS[@]}"; do
+  [ -d "$repo" ] || continue
+  compare_hint "$repo" hint-literal 'auth.*' -i -F -e config
+  # Case-sensitive: the hint follows the primary case rule, so this also covers a hint that only
+  # matches under -i and must not leak into the case-sensitive match set.
+  compare_hint "$repo" hint-case-sensitive Config -F -e config
+  # A path-shaped hint scores display paths, and -l ranks files; neither may add or drop a file.
+  compare_hint "$repo" hint-path-files-only src -l -i -F -e config
+  compare_hint "$repo" hint-word -w -i -F -e fn
+done
+
 # Exercise `--no-ignore` on a bounded fixture. A real repository can legitimately exceed hay's
 # candidate cap under this flag, which would test truncation rather than traversal parity.
