+/// Whether two hints collapse into one under the active case rule. Under `-i` equality is decided
+/// by the same regex engine that matches lines, not by Rust's `to_lowercase`, so a duplicate is
+/// exactly what the search itself would treat as the same literal (Unicode simple case folding).
+fn hints_equal(a: &str, b: &str, ignore_case: bool) -> Result<bool, String> {
+    if !ignore_case {
+        return Ok(a == b);
+    }
+    let matcher = RegexMatcherBuilder::new()
+        .case_insensitive(true)
+        .build(&format!(r"\A(?:{})\z", regex_escape(a)))
+        .map_err(|e| format!("invalid hint: {e}"))?;
+    matcher
+        .is_match(b.as_bytes())
+        .map_err(|e| format!("could not compare hints: {e}"))
+}
+
+/// Compile each already-deduplicated hint as its own literal matcher. Keeping them separate makes
+/// coverage count distinct hints rather than regex occurrences, and using the same engine as the
+/// primary search gives `-i` the same case behavior on both paths.
+fn build_hint_matchers(o: &Opts) -> Result<Vec<RegexMatcher>, String> {
+    if o.weights.hint == 0.0 {
+        return Ok(Vec::new());
+    }
+    o.hints
+        .iter()
+        .map(|hint| {
+            RegexMatcherBuilder::new()
+                .case_insensitive(o.ignore_case)
+                .build(&regex_escape(hint))
+                .map_err(|e| format!("invalid hint: {e}"))
+        })
+        .collect()
+}
+
+fn count_hint_matches(matchers: &[RegexMatcher], path: &str, line: &str) -> usize {
+    matchers
+        .iter()
+        .filter(|matcher| {
+            matcher
+                .is_match(line.as_bytes())
+                .expect("compiled regex matcher cannot fail")
+                || matcher
+                    .is_match(path.as_bytes())
+                    .expect("compiled regex matcher cannot fail")
+        })
+        .count()
+}
