+#[test]
+fn hints_rerank_only_primary_matches_and_are_ablatable() {
+    let d = tempfile::Builder::new()
+        .prefix("hint-rank")
+        .tempdir()
+        .unwrap();
+    fs::create_dir_all(d.path().join("src")).unwrap();
+    write(d.path(), "src/a.rs", "handle(timeout) generic\n");
+    write(d.path(), "src/z.rs", "handle(timeout) refund\n");
+    write(
+        d.path(),
+        "src/refund-only.rs",
+        "refund without the primary query\n",
+    );
+
+    let run = |extra: &[&str]| -> String {
+        let mut args = vec!["--no-diversify", "-F"];
+        args.extend_from_slice(extra);
+        args.extend(["timeout", "."]);
+        let out = hay().args(args).current_dir(d.path()).assert().success();
+        normalize(&String::from_utf8(out.get_output().stdout.clone()).unwrap())
+    };
+
+    let baseline = run(&[]);
+    assert!(baseline.lines().next().unwrap().contains("src/a.rs"));
+
+    let hinted = run(&["--hint", "refund"]);
+    assert!(hinted.lines().next().unwrap().contains("src/z.rs"));
+    assert!(
+        !hinted.contains("refund-only.rs"),
+        "hint-only file leaked into matches"
     );
+
+    let ablated = run(&["--hint", "refund", "--no-hint"]);
+    assert_eq!(ablated, baseline, "--no-hint must restore baseline ranking");
+
+    let sorted = |output: &str| {
+        let mut lines: Vec<String> = output.lines().map(str::to_string).collect();
+        lines.sort_unstable();
+        lines
+    };
+    assert_eq!(
+        sorted(&baseline),
+        sorted(&hinted),
+        "hints may reorder but never add or remove primary matches"
+    );
 }
 
