+#[test]
+fn duplicate_hints_do_not_amplify_the_explained_score() {
+    let d = tempfile::Builder::new()
+        .prefix("hint-duplicates")
+        .tempdir()
+        .unwrap();
+    write(d.path(), "a.txt", "timeout refund\n");
+
+    let explain = |args: &[&str]| -> String {
+        let out = hay().args(args).current_dir(d.path()).assert().success();
+        String::from_utf8(out.get_output().stdout.clone()).unwrap()
+    };
+    let once = explain(&["--explain", "--hint", "refund", "-F", "timeout", "."]);
+    let twice = explain(&[
+        "--explain",
+        "--hint",
+        "refund",
+        "--hint",
+        "refund",
+        "-F",
+        "timeout",
+        ".",
+    ]);
+    assert_eq!(once, twice, "a duplicate hint must not amplify its score");
+    assert!(
+        once.contains("hint +2.00"),
+        "full coverage should score 2.0: {once}"
+    );
+}
