+/// Does this line *head a section about* the query?
+///
+/// A markdown heading declares the section about a term exactly as `function foo` declares `foo`.
+/// ATX headings only (`## Foo`): setext headings underline the previous line, which a per-line
+/// signal cannot see. The `#` test runs first because it rejects almost every line in a code file
+/// for the price of one byte comparison, before the path is lowercased.
+pub fn looks_like_heading(path: &str, line: &str, query: &str) -> bool {
+    let t = line.trim_start();
+    let hashes = t.bytes().take_while(|b| *b == b'#').count();
+    if hashes == 0 || hashes > 6 || !t[hashes..].starts_with(' ') {
+        return false;
+    }
+    if !is_prose(&path.to_ascii_lowercase()) {
+        return false;
+    }
+    // A WHOLE word of the heading, not a prefix of one: at four times the word signal's weight a
+    // wrong firing outranks the real declaration's own file.
+    word_affinity(&t[hashes..], query) >= 1.0
+}
