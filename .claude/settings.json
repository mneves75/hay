{
  "permissions": {
    "deny": [
      "Bash(git add -f*corpus*)",
      "Bash(git add --force*corpus*)",
      "Bash(git rm*.github/workflows/release.yml*)",
      "Bash(git mv*.github/workflows/release.yml*)"
    ],
    "ask": [
      "Edit(.github/workflows/release.yml)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/hooks/claude-gate\" ] || \"$HOME/.claude/hooks/claude-gate\" baseline"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/hooks/claude-gate\" ] || \"$HOME/.claude/hooks/claude-gate\" stop -- 'cargo test --manifest-path hay/Cargo.toml && bun run typecheck && bun run lint:ast-grep'",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
